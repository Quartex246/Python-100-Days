# 6 dices, throw 6000 times, count the number of times each number appears
import random
f1, f2,f3,f4,f5,f6 = 0,0,0,0,0,0
for _ in range (6000):
    if random.randint(1,6) == 1:
        f1 += 1
    elif random.randint(1,6) == 2:
        f2 += 1
    elif random.randint(1,6) == 3:
        f3 += 1
    elif random.randint(1,6) == 4:
        f4 += 1
    elif random.randint(1,6) == 5:
        f5 += 1
    else:
        f6 += 1

print(f"1: {f1}, 2: {f2}, 3: {f3}, 4: {f4}, 5: {f5}, 6: {f6}")
